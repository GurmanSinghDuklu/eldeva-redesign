# Copy this file to .env and fill in the values. .env is git-ignored: never commit it or paste keys into chat.

# Stripe: Dashboard > Developers > API keys (start in test mode)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Filled in during setup, when the webhook is created
STRIPE_WEBHOOK_SECRET=whsec_...

# Royal Mail Click & Drop: Settings > Integrations > Click & Drop API
CLICKDROP_API_KEY=

# Email sending (chosen during setup)
EMAIL_API_KEY=
EMAIL_FROM=orders@eldeva.co.uk

# Public address of the site, used in links in emails and Stripe redirects
SITE_URL=http://localhost:8765
